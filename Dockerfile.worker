# syntax=docker/dockerfile:1

FROM node:22-bookworm AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

# Compiles the worker, shared lib, and node scripts (migrate/schedule/health)
# to dist-worker/ so production runs plain node with no dev dependencies.
FROM node:22-bookworm AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npx tsc -p tsconfig.worker.json

FROM node:22-bookworm AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/dist-worker ./dist-worker
# migrate.js reads db/migrations relative to the working directory.
COPY --from=builder /app/db ./db
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
CMD ["node", "dist-worker/worker/index.js"]
